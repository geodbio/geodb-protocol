# The public sandbox grant — read-only, one open-data demonstration project,
# throttled, rotated periodically. No signup, no account, no NDA.
#
#   cp sandbox.env.example sandbox.env && . ./sandbox.env
#
# Every file under examples/ runs as-is once these two are set.

# The sandbox token, as printed in AGENTS.md §2. Replace with a grant of your
# own (Project Settings -> API Access Grants) to read a real project.
export GEODB_TOKEN=<SANDBOX_TOKEN>

# The server. Override for a self-hosted geoDB or a second implementation of
# this protocol; every example honours it.
export GEODB_BASE_URL=https://api.geodb.io
