{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geodb.io/exploration/v0.1.0/interval.json",
  "title": "Downhole interval",
  "description": "A generic depth-from/depth-to interval carrying a geological interpretation (lithology, alteration, mineralization, structure, RQD, vein, or a custom type). Part of the geoDB Open Exploration Protocol (chain-of-custody records lane).",
  "type": "object",
  "required": [
    "hole_id",
    "depth_from",
    "depth_to"
  ],
  "properties": {
    "hole_id": {
      "type": "string",
      "description": "Collar identifier."
    },
    "depth_from": {
      "type": [
        "number",
        "null"
      ],
      "description": "Interval top (project length units)."
    },
    "depth_to": {
      "type": [
        "number",
        "null"
      ],
      "description": "Interval base (project length units)."
    },
    "interval_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "lithology | alteration | mineralization | structure | rqd | vein | custom."
    },
    "code": {
      "type": [
        "string",
        "null"
      ],
      "description": "Logged code/value (e.g. lithology code)."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text logging note."
    }
  },
  "additionalProperties": true
}
