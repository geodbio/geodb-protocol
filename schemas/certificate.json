{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geodb.io/exploration/v0.1.0/certificate.json",
  "title": "Assay certificate",
  "description": "A lab certificate / job \u2014 the chain-of-custody anchor tying a batch of assay results to a laboratory and a set of analytical methods. Part of the geoDB Open Exploration Protocol (chain-of-custody records lane).",
  "type": "object",
  "required": [
    "certificate_number",
    "laboratory"
  ],
  "properties": {
    "certificate_number": {
      "type": "string",
      "description": "Lab certificate / job number."
    },
    "laboratory": {
      "type": "string",
      "description": "Issuing laboratory name (see laboratory.json)."
    },
    "date_received": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 date samples received by the lab."
    },
    "date_reported": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 date results reported."
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Analytical method codes on this certificate."
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Element symbols reported."
    }
  },
  "additionalProperties": true
}
